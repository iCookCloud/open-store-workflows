{
  "name": "@osw/fitout-bom",
  "version": "0.1.0",
  "type": "module",
  "license": "Apache-2.0",
  "files": ["dist", "prompts", "README.md"],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./providers/openai-compatible": {
      "types": "./dist/providers/openai-compatible.d.ts",
      "default": "./dist/providers/openai-compatible.js"
    }
  },
  "osw": {
    "workflow": true
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "pnpm build && vitest run --config vitest.config.ts",
    "examples": "pnpm build && tsx scripts/check-examples.ts",
    "examples:generate": "pnpm build && tsx scripts/generate-examples.ts"
  },
  "dependencies": {
    "@osw/core": "workspace:*"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/iCookCloud/open-store-workflows.git",
    "directory": "packages/fitout-bom"
  },
  "homepage": "https://github.com/iCookCloud/open-store-workflows/tree/main/packages/fitout-bom",
  "bugs": {
    "url": "https://github.com/iCookCloud/open-store-workflows/issues"
  },
  "devDependencies": {
    "@osw/mcp": "workspace:*",
    "@modelcontextprotocol/sdk": "^1.25.0",
    "vitest": "^3.2.0",
    "tsx": "^4.20.0"
  }
}
