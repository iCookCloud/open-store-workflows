{
  "name": "@osw/landed-delivery",
  "version": "0.1.0",
  "type": "module",
  "license": "Apache-2.0",
  "files": ["dist"],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "pnpm build && vitest run --config vitest.config.ts",
    "examples": "pnpm build && node scripts/check-delivery-example.mjs && node scripts/check-warehouse-example.mjs",
    "examples:generate": "pnpm build && node scripts/generate-delivery-example.mjs && node scripts/generate-warehouse-example.mjs"
  },
  "dependencies": {
    "@osw/core": "workspace:*"
  },
  "osw": {
    "workflow": true
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/iCookCloud/open-store-workflows.git",
    "directory": "packages/landed-delivery"
  },
  "homepage": "https://github.com/iCookCloud/open-store-workflows/tree/main/packages/landed-delivery",
  "bugs": {
    "url": "https://github.com/iCookCloud/open-store-workflows/issues"
  },
  "devDependencies": {
    "@osw/mcp": "workspace:*",
    "@modelcontextprotocol/sdk": "^1.25.0",
    "vitest": "^3.2.0",
    "tsx": "^4.20.0"
  }
}
