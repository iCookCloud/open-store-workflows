{
  "name": "@osw/build-out",
  "version": "0.1.0",
  "type": "module",
  "license": "Apache-2.0",
  "files": ["dist", "README.md", "examples", "scripts"],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
