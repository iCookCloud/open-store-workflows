{
  "name": "open-store-workflows",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@9.14.2",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "test": "vitest run",
    "lint": "biome check .",
    "format": "biome check --write .",
    "boundaries": "node scripts/check-boundaries.mjs",
    "runtime": "node scripts/check-runtime.mjs",
    "scan": "node scripts/scan-private.mjs",
    "examples": "node scripts/example-check.mjs",
    "check": "pnpm build && pnpm lint && pnpm typecheck && pnpm test && pnpm boundaries && pnpm runtime && pnpm examples && pnpm scan",
    "osw": "node packages/core/dist/node/cli.js"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "@changesets/cli": "^2.29.0",
    "@types/node": "^22.10.0",
    "esbuild": "^0.25.0",
    "typescript": "^5.9.0",
    "vitest": "^3.2.0",
    "tsx": "^4.20.0",
    "@osw/core": "workspace:*",
    "@osw/store-concept": "workspace:*",
    "@osw/mcp": "workspace:*",
    "@osw/opening": "workspace:*"
  }
}
